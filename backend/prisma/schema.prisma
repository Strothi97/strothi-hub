generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── MODELLE ──────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dashboard-Einstellungen (Kachel-Reihenfolge & Sichtbarkeit)
  hideComingSoonTools Boolean @default(false)
  toolOrder           Json?
  // Hell/Dunkel-Design, kontogebunden statt nur lokal im Browser (localStorage
  // bleibt als schnelle Bootstrap-Vorschau vor dem Laden des Kontos erhalten).
  theme               String  @default("dark")

  toolAccess          UserToolAccess[]
  workDayEntries      WorkDayEntry[]
  federalStates       UserFederalState[]
  vacationAdjustments VacationAdjustment[]
  farsiEntries        FarsiEntry[]
  farsiProgress       FarsiProgress[]
  farsiLetterProgress FarsiLetterProgress[]
  reminders           Reminder[]
  people              Person[]
  pushSubscriptions   PushSubscription[]
  inviteTokens        InviteToken[]
  recipes             Recipe[]
  recipeRatings       RecipeRating[]
  exercises           Exercise[]
  trainingSessions    TrainingSession[]
  focusAreas          FocusArea[]
  equipment           Equipment[]

  @@map("users")
}

// Einmal-Link, den ein Admin per E-Mail an eine neue Adresse schickt, um
// dieser Person die Wahl eines eigenen Passworts zu ermöglichen (statt
// dass der Admin selbst eins ausdenkt).
model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

// Freigabe, welcher Nutzer welches Tool (per toolKey aus der
// Registry in src/config/tools.ts) sehen/nutzen darf.
model UserToolAccess {
  id        String   @id @default(cuid())
  userId    String
  toolKey   String
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolKey])
  @@map("user_tool_access")
}

// ── Tool: Arbeitsnachweis ───────────────────────────────

enum WorkDayStatus {
  OFFICE
  HOME_OFFICE
  HOLIDAY
  PUBLIC_HOLIDAY
  SICK
}

enum Bundesland {
  BW
  BY
  BE
  BB
  HB
  HH
  HE
  MV
  NI
  NW
  RP
  SL
  SN
  ST
  SH
  TH
}

// Explizite Eintragung eines Nutzers für einen Werktag. Tage ohne
// Eintrag werden zur Laufzeit ggf. automatisch als Feiertag erkannt
// (siehe modules/homeoffice/homeoffice.service.ts), landen aber nicht
// automatisch hier in der DB.
model WorkDayEntry {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime      @db.Date
  status    WorkDayStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("work_day_entries")
}

// Verlauf: "Ab validFrom gilt für diesen Nutzer Bundesland state"
// (für die automatische Feiertagserkennung bei Umzügen).
model UserFederalState {
  id        String     @id @default(cuid())
  userId    String
  state     Bundesland
  validFrom DateTime   @db.Date
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_federal_states")
}

// Manuelle Korrektur der Urlaubstage eines Jahres (z.B. Umzug, Rest aus Vorjahr).
model VacationAdjustment {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vacation_adjustments")
}

// ── Tool: Farsi lernen ───────────────────────────────────

enum FarsiWordType {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  QUESTION_WORD
  PREPOSITION
  CONJUNCTION
  NUMBER
  PHRASE
  IDIOM
  OTHER
}

model FarsiEntry {
  id            String         @id @default(cuid())
  userId        String
  german        Json // string[] – auch bei genau einer Bedeutung
  persianLatin  Json // string[] – Lautschrift/Transliteration
  persianScript String? // Original-Schrift, z.B. "خانه" (optional)
  type          FarsiWordType?
  meaning       String? // optionale Zusatzerklärung
  // Nur bei type=VERB sinnvoll: Präsensstamm (oft unregelmäßig, nicht aus
  // dem Infinitiv ableitbar) — analog zu persianLatin/persianScript als
  // getrenntes Lautschrift-/Originalschrift-Paar statt einem Feld.
  verbStemLatin  String?
  verbStemScript String?
  // 1 = am wichtigsten, 5 = am unwichtigsten; kein Wert = noch nicht
  // eingestuft (zählt nicht automatisch als "wichtig" oder "unwichtig").
  priority      Int?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress FarsiProgress[]

  @@map("farsi_entries")
}

// Leitner-Karteikarten: Fortschritt pro Nutzer/Eintrag/Modus getrennt,
// da Bedeutungs- und Schrift-Erkennung unterschiedliche Fähigkeiten mit
// eigenem Lerntakt sind (siehe modules/farsi/farsi.service.ts).
enum FarsiStudyMode {
  VOCAB // Deutsch ↔ Farsi
  SCRIPT // Lautschrift ↔ Originalschrift
}

model FarsiProgress {
  id             String         @id @default(cuid())
  userId         String
  entryId        String
  mode           FarsiStudyMode
  box            Int            @default(1)
  dueAt          DateTime       @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry FarsiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([userId, entryId, mode])
  @@index([userId, mode, dueAt])
  @@map("farsi_progress")
}

// Fortschritt für die Buchstaben-Lernübung. Buchstaben sind keine
// FarsiEntry-Zeilen (statische Liste im Frontend, alphabet.ts) — das
// Backend kennt daher nur Fortschritts-Zeilen zu beliebigen
// letterChar-Strings, keine Referenzliste der 32 Buchstaben. Fortschritt
// wird pro Buchstabe UND Position getrennt geführt (isoliert/Anfang/
// Mitte/Ende zählen als eigene Karte) — Erkennen der isolierten Form
// heißt nicht, dass auch die Mittelform sitzt.
model FarsiLetterProgress {
  id             String    @id @default(cuid())
  userId         String
  letterChar     String
  position       String // 'isolated' | 'initial' | 'medial' | 'final'
  box            Int       @default(1)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, letterChar, position])
  @@index([userId, dueAt])
  @@map("farsi_letter_progress")
}

// ── Tool: Erinnerungen ───────────────────────────────────

enum ReminderRecurrence {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM_INTERVAL
  WEEKDAYS
}

enum IntervalUnit {
  DAY
  WEEK
  MONTH
}

model Reminder {
  id           String             @id @default(cuid())
  userId       String
  title        String
  note         String?
  recurrence   ReminderRecurrence
  startDate    DateTime           @db.Date
  endDate      DateTime?          @db.Date // optional, nur bei wiederkehrenden Erinnerungen sinnvoll
  intervalN    Int? // nur CUSTOM_INTERVAL
  intervalUnit IntervalUnit? // nur CUSTOM_INTERVAL
  weekdays     Json? // nur WEEKDAYS: number[] (0=So..6=Sa)
  times        Json // string[] "HH:MM", mind. 1
  leadReminders Json? // nur ONCE: zusätzliche Vorab-Erinnerungen vor startDate,
  // Array<{ offsetN: number; offsetUnit: IntervalUnit; time: string }>
  active       Boolean            @default(true)
  isTodo       Boolean            @default(false) // ToDo statt Termin/Erinnerung — eigener Tab, per Checkbox abhakbar
  completedAt  DateTime? // nur bei isTodo relevant; gesetzt = abgehakt, Scheduler feuert dann nicht mehr
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

model Person {
  id                   String   @id @default(cuid())
  userId               String
  firstName            String
  lastName             String?
  birthday             DateTime @db.Date // Jahr wird für Altersanzeige genutzt
  photoUrl             String?
  congratsCheckEnabled Boolean  @default(true) // 20-Uhr-Rückfrage an/aus
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  congratsLog PersonCongratsLog[]

  @@map("people")
}

// Ob für eine Person in einem bestimmten Jahr schon "gratuliert" bestätigt wurde.
model PersonCongratsLog {
  id            String   @id @default(cuid())
  personId      String
  year          Int
  congratulated Boolean  @default(false)
  respondedAt   DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, year])
  @@map("person_congrats_log")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String
  auth      String
  userAgent String? // grober Geräte-/Browser-Hinweis für die Konto-Seite, z.B. "Firefox · Windows"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

// Generisches Dedupe-Log, damit der minütliche Scheduler dieselbe
// Benachrichtigung nicht zweimal verschickt (kind+refId+Zeitschlitz eindeutig).
model NotificationLog {
  id           String   @id @default(cuid())
  userId       String
  kind         String // 'reminder' | 'birthday_morning' | 'birthday_checkin'
  refId        String // reminderId oder personId
  scheduledFor String // "YYYY-MM-DD HH:MM", Dedupe-Schlüssel
  createdAt    DateTime @default(now())

  @@unique([kind, refId, scheduledFor])
  @@map("notification_logs")
}

// ── Kochbuch ──────────────────────────────────────────────

// Flach modelliert wie FarsiEntry/Reminder: Zutaten und Schritte leben als
// Json-Array direkt auf dem Rezept statt in eigenen Tabellen — sie werden
// nie unabhängig vom Rezept abgefragt, und die Datenmenge eines privaten
// Kochbuchs ist klein. Struktur der Json-Felder (siehe kochbuch.service.ts):
//   ingredients: Array<{ name: string; amounts: Array<{ servings: number; amount: string }> }>
//   steps:       Array<{ stepNumber: number; title: string | null; instructions: string[]; photoUrl: string | null }>
// Mengenangaben bleiben als Roh-String je Personenzahl erhalten (z.B. "1,5 **"
// bei HelloFresh-Karten) statt rechnerisch skaliert — die Originalwerte sind
// nicht immer exakt linear und Fußnoten (**) lassen sich so verlustfrei mit
// übernehmen. Jeder Schritt kann optional ein eigenes Foto haben (Upload je
// Schritt, siehe kochbuch.service.ts saveStepPhoto) — unabhängig vom
// Titelbild (photoUrl auf dem Rezept selbst).
model Recipe {
  id                 String    @id @default(cuid())
  userId             String
  title              String
  subtitle           String?
  source             String? // z.B. "HelloFresh", frei befüllbar
  tags               Json? // string[], z.B. ["Vegetarisch", "Viel Gemüse"]
  allergens          Json? // string[], z.B. ["Milch", "Sellerie"]
  prepTimeMinMinutes Int?
  prepTimeMaxMinutes Int?
  kcal               Int?
  rating             Float? // veraltet, durch RecipeRating (pro Nutzer + Durchschnitt) ersetzt — Spalte bleibt für Altbestand, wird nicht mehr beschrieben
  category           String? // 'fleisch' | 'fisch' | 'vegetarisch' | 'vegan' — null = keine Angabe, siehe RecipeCategory in kochbuch.service.ts
  categoryNote       String? // z.B. "geht auch vegetarisch, wenn man Hähnchen durch Tofu ersetzt" — freie Erweiterung zur Kategorie
  mealType           String? // 'vorspeise' | 'hauptgericht' | 'beilage' | 'dessert' | 'snack' — Pflichtfeld im Formular (RezeptForm.tsx), DB-seitig aber nullable wie category (Altbestand/Transfer-Import dürfen es (noch) nicht haben, siehe getCompleteness in format.ts)
  photoUrl           String?
  servingSizes       Json // number[], z.B. [2, 3, 4] — welche Personenzahlen die Karte angibt
  pantryStaples      Json? // string[], z.B. ["Salz", "Olivenöl", "Pfeffer"] — nicht mitgeliefert
  ingredients        Json // siehe Kommentar oben
  steps              Json // siehe Kommentar oben (inkl. optionalem photoUrl je Schritt)
  note               String? // freie Notiz (z.B. eigene Anpassungen)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings RecipeRating[]

  @@map("recipes")
}

// Bewertung ist personenbezogen (jeder im geteilten Kochbuch bewertet für
// sich) — Durchschnitt wird zur Anzeige aus diesen Zeilen berechnet, nicht
// gespeichert. Eigenes Modell statt Json-Array auf Recipe (anders als
// ingredients/steps oben), weil pro (Rezept, Nutzer) genau ein Wert gilt
// (@@unique) und das Setzen/Ändern so ohne Read-Modify-Write auskommt.
model RecipeRating {
  id       String @id @default(cuid())
  recipeId String
  userId   String
  value    Float // 0–5, Nachkommastellen erlaubt (z.B. 3.5, 3.3)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipeId, userId])
  @@map("recipe_ratings")
}

// ── Tool: Trainingsplan ──────────────────────────────────

enum ExerciseUnit {
  KG
  G
  S
  MIN
  H
  KM
  M
  BODYWEIGHT // reine Wiederholungsübung (z.B. Klimmzüge) — kein Gewichtsfeld beim Loggen
}

// Trainingsbereich pro Nutzer (Brust, Rücken, ...). key ist ein stabiler
// Schlüssel, unter dem Übungen den Bereich in Exercise.focusAreas referenzieren —
// Umbenennen ändert nur name/icon, nie den Schlüssel.
model FocusArea {
  id        String   @id @default(cuid())
  userId    String
  key       String
  name      String
  icon      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("focus_areas")
}

// Trainingsgerät pro Nutzer (Rückengerät, Butterfly, ...). key ist stabil und wird
// in Exercise.equipmentKey gespeichert — Umbenennen ändert nur name.
model Equipment {
  id        String   @id @default(cuid())
  userId    String
  key       String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("equipment")
}

// Katalog-Eintrag einer Übung. Anders als Kochbuchs category/mealType (die
// wegen Altbestand nullable bleiben mussten) sind focusAreas und unit hier
// Pflichtfelder — neues Tool, kein Altbestand, kein Migrationsschmerz.
// focusAreas ist bewusst Json statt Prisma-Enum-Array: MySQL unterstützt
// (anders als Postgres) keine nativen Skalar-Listen, auch nicht für Enums —
// daher wie tags/allergens bei Recipe ein Json-String-Array, serverseitig
// gegen EXERCISE_FOCUS_AREAS geprüft (siehe trainingsplan.service.ts).
// archivedAt: eine bereits in Einheiten geloggte Übung kann nicht gelöscht
// werden (siehe deleteExercise), sondern nur archiviert — bleibt für
// Historie/Statistik voll nutzbar, verschwindet nur aus der
// "Übung hinzufügen"-Auswahl und (per Default) aus der Katalog-Liste.
model Exercise {
  id            String        @id @default(cuid())
  userId        String
  name          String
  focusAreas    Json // string[] aus fixer Liste (siehe EXERCISE_FOCUS_AREAS), Pflicht, mind. 1 Eintrag
  unit          ExerciseUnit
  // Optionale zweite Einheit, z.B. Laufen = km (unit) + min (secondaryUnit).
  // Beim Loggen einer Runde gibt es dann ein zusätzliches Wertefeld
  // (SetEntry.secondaryValue). Nicht gesetzt = einwertige Übung (Normalfall).
  secondaryUnit ExerciseUnit?
  // Schlüssel eines Trainingsgeräts des Nutzers, null = kein Gerät (freie Übung)
  equipmentKey  String?
  imageUrl      String?
  // Array<{ title: string; text: string; imageUrl: string | null }> — flach
  // wie RecipeStep bei Kochbuch, nie unabhängig von der Übung abgefragt.
  // Rendert im Frontend als aufwendig gestaltetes Popup (UebungInfoModal).
  infoSections  Json?
  archivedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionExercises SessionExercise[]

  @@map("exercises")
}

// Eine geloggte Trainingseinheit. performedAt ist ein voller Zeitstempel
// (Datum + Uhrzeit, kein @db.Date) — der UTC/Lokal-Verschiebungs-Pitfall aus
// date-utils.ts betrifft nur @db.Date-Spalten (reines Kalenderdatum ohne
// Uhrzeit); ein DateTime-Wert transportiert einen vollen Instant und wird
// von Prisma/MySQL verlustfrei rund-getripped. Zeitzone spielt aber bei der
// client-seitigen Häufigkeits-/Streak-Bucketing-Logik eine Rolle (siehe
// format.ts im Frontend).
model TrainingSession {
  id          String   @id @default(cuid())
  userId      String
  performedAt DateTime
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises SessionExercise[]

  // Für die Sessions-Liste (sortiert) und die client-seitige Häufigkeits-/
  // Streak-Berechnung auf der Übersicht.
  @@index([userId, performedAt])
  @@map("training_sessions")
}

// Eine geloggte Übung innerhalb einer Einheit. exercise-FK ist bewusst
// Restrict (nicht Cascade) — Löschen einer Übung, die schon geloggt wurde,
// soll die Historie nicht mitreißen (siehe deleteExercise in
// trainingsplan.service.ts, das vorher explizit prüft und blockiert).
// WICHTIG: das erfordert eine Anpassung an auth.controller.ts (Konto
// löschen muss TrainingSession vor dem User löschen, sonst kann das
// Restrict beim Geschwister-Kaskadierungspfad über Exercise zuschlagen).
model SessionExercise {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  order      Int // Position in der Einheit, für die Ablauf-Darstellung; beim Anhängen serverseitig vergeben
  createdAt  DateTime @default(now())

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     SetEntry[]

  @@map("session_exercises")
}

// Eine "Runde" (Satz) innerhalb einer geloggten Übung. value ist der Wert in
// der Haupteinheit der zugehörigen Exercise (z.B. kg, km, min) — bleibt null
// bei reinen Bodyweight-Sätzen (unit = BODYWEIGHT, nur reps zählt) oder
// direkt nach dem Anlegen einer neuen leeren Runde. reps ist unabhängig
// davon optional (leer bei reinem Zeit-/Distanz-Cardio, siehe
// ExerciseUnit-Kommentar). secondaryValue ist der Wert in Exercise.secondaryUnit,
// falls die Übung eine zweite Einheit hat (z.B. Laufzeit neben Distanz) —
// sonst immer null.
model SetEntry {
  id                String @id @default(cuid())
  sessionExerciseId String
  order             Int // Runden-Reihenfolge (1., 2., 3. ...), serverseitig aus der Array-Position vergeben
  value             Float?
  reps              Int?
  secondaryValue    Float?

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@map("set_entries")
}

// Weitere Modelle hier ergänzen:
// model Post { ... }
