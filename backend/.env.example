# Server
PORT=5000
NODE_ENV=development

# Datenbank (MariaDB / MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/dbname"

# JWT
JWT_SECRET=dein-super-geheimer-jwt-schluessel-hier-aendern
JWT_EXPIRES_IN=7d

# Initialer Admin-Account (wird von prisma/seed.ts angelegt)
ADMIN_EMAIL=admin@strothi.de
ADMIN_PASSWORD=bitte-aendern
ADMIN_NAME=Admin

# CORS
CORS_ORIGIN=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Web Push (VAPID) — für Erinnerungen/Geburtstage-Benachrichtigungen
# Einmalig generieren: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@strothi.de

# SMTP — für Einladungs-E-Mails (Nutzerverwaltung)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@strothi.de

# Anthropic API — für den Kochbuch-Foto-Import (Rezeptkarte fotografieren,
# Claude liest Zutaten/Schritte aus). Eigener API-Key von console.anthropic.com,
# NICHT das Claude-Abo — Budget-Limit dort am Key setzen, nicht hier im Code.
# Ohne diesen Key bleibt der Import-Button im Kochbuch deaktiviert.
ANTHROPIC_API_KEY=
